{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "PolyMechanism Studio",
  "version": "1.0.0",
  "frame": { "width": 1600, "height": 1000, "grid": 8 },
  "color": {
    "brand": { "light": "#4F6BFF", "dark": "#6E86FF" },
    "brand-strong": { "light": "#3D53D9", "dark": "#8B9DFF" },
    "brand-soft": { "light": "#EDF0FF", "dark": "#171F3D" },
    "brand-ink": { "light": "#2F3FA8", "dark": "#B7C2FF" },
    "surface": { "light": "#FFFFFF", "dark": "#121821" },
    "surface-subtle": { "light": "#F2F4F8", "dark": "#141A24" },
    "surface-hover": { "light": "#EEF1F7", "dark": "#182030" },
    "sidebar": { "light": "#FAFBFD", "dark": "#0B0F16" },
    "text-1": { "light": "#12151C", "dark": "#E9EDF6" },
    "text-2": { "light": "#596174", "dark": "#9AA4B8" },
    "text-3": { "light": "#667085", "dark": "#7D889D" },
    "border": { "light": "#E5E8EF", "dark": "#1D2431" },
    "border-strong": { "light": "#D7DCE7", "dark": "#2A3242" },
    "teal": { "light": "#0E9F87", "dark": "#2CC3A8" },
    "teal-soft": { "light": "#E5F6F1", "dark": "#0F2B26" },
    "amber": { "light": "#B07610", "dark": "#E0AC4D" },
    "amber-soft": { "light": "#FBF2DF", "dark": "#2C2314" },
    "rose": { "light": "#C94B5B", "dark": "#EF7180" },
    "violet": { "light": "#7A66E0", "dark": "#A392FF" }
  },
  "typography": {
    "family-ui": "Inter, SF Pro Text, Segoe UI Variable Text, Segoe UI, PingFang SC, Microsoft YaHei, system-ui, sans-serif",
    "family-mono": "JetBrains Mono, SFMono-Regular, Consolas, Liberation Mono, monospace",
    "hero": { "size": "clamp(28px, 2.7vw, 40px)", "weight": 640, "line-height": 1.16, "letter-spacing": "-0.028em" },
    "body": { "size": 13, "line-height": 1.5, "weight": 400 },
    "subline": { "size": 13.5, "line-height": 1.6, "weight": 400 },
    "panel-title": { "size": 12, "line-height": 16, "weight": 600, "letter-spacing": "0.02em" },
    "label": { "size": 11, "line-height": 14, "weight": 500 },
    "micro": { "size": 9.5, "letter-spacing": "0.16em", "weight": 550, "transform": "uppercase" },
    "data": { "size": 12.5, "line-height": 18, "variant-numeric": "tabular-nums" }
  },
  "space": { "0": 0, "1": 4, "2": 8, "3": 10, "4": 12, "5": 14, "6": 16, "7": 20, "8": 24, "9": 26, "10": 32, "11": 40, "12": 48 },
  "radius": { "control": 6, "card": 8, "panel": 0, "composer": 10, "pill": 999 },
  "shadow": {
    "card": { "light": "0 1px 2px rgba(18,21,28,.04), 0 10px 28px rgba(18,21,28,.07)", "dark": "0 1px 2px rgba(0,0,0,.25), 0 12px 32px rgba(0,0,0,.35)" },
    "float": { "light": "0 12px 40px rgba(18,21,28,.14)", "dark": "0 16px 48px rgba(0,0,0,.5)" }
  },
  "size": {
    "titlebar": 38,
    "sidebar": 288,
    "main-header": 52,
    "home-column": 860,
    "composer": 168,
    "station-chip": 28,
    "quick-card": 48,
    "pulse-row": 20
  },
  "motion": {
    "hover": "140ms ease",
    "focus": "160ms ease",
    "decorative": "none (product shell)",
    "reduced-motion": "none"
  },
  "layout": {
    "titlebar": "38px · remote status left · centered product lockup · window controls right",
    "sidebar": "288px · brand 54 · new session 36 · nav 32 · workspace list · footer 44",
    "home": "max 860px · vertically centered · padding inline 32",
    "station": "label + six chips + readiness, 28px tall",
    "quick": "3 equal columns, gap 8",
    "pulse": "label + four numeric items + CAE status"
  }
}
